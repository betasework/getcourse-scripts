function csv(){const rows=datasets().visible;const head=['Раздел','Урок','Ссылка','Статус','Зашли','Ответили','Прошли','Доля ответов, %','Разница посещений','Разница, %','Сигнал'];const data=[head,...rows.map(r=>[r.path,r.title,r.href,r.status,r.entered,r.answered,r.passed,r.rate,r.delta,r.deltaPct===null?'':Math.round(r.deltaPct),signal(r)[0]])];const cell=v=>{let s=String(v??'');if(/^[\s]*[=+@-]/.test(s)&&typeof v!=='number')s="'"+s;return '"'+s.replace(/"/g,'""')+'"';};const blob=new Blob(['\ufeff'+data.map(r=>r.map(cell).join(';')).join('\r\n')],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='TrainStat-'+course+'-'+new Date().toISOString().slice(0,10)+'.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),10000);}
root.addEventListener('click',e=>{const a=e.target.closest('[data-action]')?.dataset.action;if(a==='csv')csv();if(a==='native'){root.dataset.native=root.dataset.native==='hidden'?'shown':'hidden';document.querySelectorAll('.lessons-table,#gc-stat-upgrade-root').forEach(x=>x.style.display=x.style.display==='none'?'':'none');}if(a==='reset'){search='';scope='all';signalFilter='all';sort='order';draw();}if(a==='retry'){abort.abort();root.innerHTML='<p>Нажмите закладку TrainStat ещё раз для повторной загрузки.</p>';}});
root.addEventListener('input',e=>{if(e.target.dataset.action==='search'){const pos=e.target.selectionStart;search=e.target.value;draw();const input=root.querySelector('[data-action=search]');input.focus();input.setSelectionRange(pos,pos);}});
root.addEventListener('change',e=>{const t=e.target;if(t.dataset.section){const set=new Set(cfg.excluded);if(t.checked)set.delete(t.dataset.section);else set.add(t.dataset.section);cfg.excluded=[...set];save();}else if(t.dataset.setting){cfg[t.dataset.setting]=t.type==='checkbox'?t.checked:Math.max(t.dataset.setting==='drop'?1:0,Math.min(100,Number(t.value)||0));save();}else if(t.dataset.action==='scope')scope=t.value;else if(t.dataset.action==='signal')signalFilter=t.value;else if(t.dataset.action==='sort')sort=t.value;else if(t.dataset.action==='mode')mode=t.value;else return;const details=root.querySelectorAll('details');const opens=[...details].map(x=>x.open);draw();root.querySelectorAll('details').forEach((x,i)=>x.open=opens[i]??x.open);});
try{await load(course,title,title);loading=false;if(abort.signal.aborted)return;if(!sections.some(s=>s.rows.length)){root.innerHTML='<h2>TrainStat</h2><div class="notice warning">Не удалось получить уроки. Проверьте доступ к статистике и повторите запуск.</div>'+errors.map(e=>`<p>${esc(e)}</p>`).join('');return;}draw();hideNativeChart();document.querySelectorAll('.lessons-table,#gc-stat-upgrade-root').forEach(x=>x.style.display='none');}catch(e){if(!abort.signal.aborted)root.innerHTML='<h2>TrainStat</h2><p class="notice warning">'+esc(e.message)+'</p>';}
})();

